# Token de autenticação da PushinPay (Bearer). Pegue no painel PushinPay > Aplicações.
PUSHINPAY_TOKEN=coloque_seu_token_aqui

# URL base da API da PushinPay (normalmente não precisa mudar)
PUSHINPAY_BASE_URL=https://api.pushinpay.com.br

# URL pública que a PushinPay vai chamar quando o pagamento mudar de status
# (precisa ser uma URL acessível pela internet, não localhost)
WEBHOOK_URL=https://seu-dominio.com.br/api/pix/webhook

# Porta do servidor local
PORT=3000
