# Secret Key da PinPay (sk_live_... ou sk_test_...). Painel PinPay > Chaves de API.
# NUNCA commitar o valor real — esse arquivo é só um modelo.
PINPAY_TOKEN=sk_live_coloque_sua_chave_aqui

# URL base da API (normalmente não precisa mudar)
PINPAY_BASE_URL=https://api.usepinpay.com/functions/v1/api-v1

# URL pública que a PinPay vai chamar quando o status do pagamento mudar
# (precisa ser uma URL acessível pela internet, não localhost)
PINPAY_WEBHOOK_URL=https://seu-dominio.com.br/api/pix/webhook

# Signing Secret (whsec_...) desse webhook específico — painel PinPay > Webhooks.
# Usado pra validar a assinatura HMAC de cada evento recebido.
PINPAY_WEBHOOK_SECRET=whsec_coloque_o_secret_aqui

# Porta do servidor local
PORT=3000
